# not in the repository: ROMs, your settings, builds (the BIOS is: system/bios.bin, free for
# non-commercial use by Smith Engineering's permission)
/roms/
/overlays/*
# (the overlays that come with the emulator: the MiSTer core's set, renamed for the ROMs - overlays/CREDITS.md,
# overlays/RENAMED.txt; PNGs of your own stay local)
!/overlays/*.art
!/overlays/CREDITS.md
!/overlays/RENAMED.txt
/games/
Vectrex_EMU.conf
system/settings.json
*.zip
*.exe
/core/
/build/
dist-*/
__pycache__/
*.pyc
*.sav
/archive/
# the SP0256-AL2 speech ROM ((c) Microchip): the user downloads it, it is never shared from here
system/sp0256-al2.bin
system/al2.bin
# local only: the SD card folder, unpacked VecFever files, PiTrex files, SD card images, notes
/sd/
/v4e/
/pitrex/
/pitrex_new/
*.img
