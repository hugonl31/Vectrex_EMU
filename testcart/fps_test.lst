                      (     fps_test.asm):00001         ; fps_test.asm - a still picture whose frame rate changes every 128 frames, to compare the emulator's
                      (     fps_test.asm):00002         ; brightness with a real Vectrex as a game slows down (on the tube the picture keeps its brightness; only
                      (     fps_test.asm):00003         ; the mains wobble grows). The BIOS starts a frame every Vec_Rfrsh cycles (30000 = 50 fps at 1.5 MHz).
                      (     fps_test.asm):00004         ; Phases (the name on screen): 50 FPS, 40 FPS, 30 FPS, 25 FPS, 50/25 ALTERNATE, IRREGULAR - then again.
                      (     fps_test.asm):00005         ; Build: lwasm --format=raw -o fps_test_raw.bin fps_test.asm, then pad to 32768 bytes with $FF.
                      (     fps_test.asm):00006         ; -DLINE: one long horizontal line instead of the boxes (fps_line.bin, roms\FPS Line Test.bin).
                      (     fps_test.asm):00007         
     F192             (     fps_test.asm):00008         Wait_Recal      equ $F192
     F2AB             (     fps_test.asm):00009         Intensity_a     equ $F2AB
     F312             (     fps_test.asm):00010         Moveto_d        equ $F312
     F354             (     fps_test.asm):00011         Reset0Ref       equ $F354
     F37A             (     fps_test.asm):00012         Print_Str_d     equ $F37A
     F3CE             (     fps_test.asm):00013         Draw_VLc        equ $F3CE
     F3DF             (     fps_test.asm):00014         Draw_Line_d     equ $F3DF
     C83D             (     fps_test.asm):00015         Vec_Rfrsh       equ $C83D
     D004             (     fps_test.asm):00016         VIA_t1_cnt_lo   equ $D004
                      (     fps_test.asm):00017         
     C880             (     fps_test.asm):00018         Count           equ $C880               ; frames in this phase
     C881             (     fps_test.asm):00019         Phase           equ $C881               ; 0..5
     C882             (     fps_test.asm):00020         Step            equ $C882               ; the frame within the alternate / irregular pattern
                      (     fps_test.asm):00021         
                      (     fps_test.asm):00022                 org     $0000
