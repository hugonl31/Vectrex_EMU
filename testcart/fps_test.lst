                      (     fps_test.asm):00074                 jsr     Reset0Ref
                      (     fps_test.asm):00075                 lda     #$FF
                      (     fps_test.asm):00076                 sta     VIA_t1_cnt_lo
                      (     fps_test.asm):00077                 ldd     #$00A0                  ; (y 0, x -96)
                      (     fps_test.asm):00078                 jsr     Moveto_d
                      (     fps_test.asm):00079                 ldd     #$0060                  ; (dy 0, dx 96)
                      (     fps_test.asm):00080                 jsr     Draw_Line_d
                      (     fps_test.asm):00081                 ldd     #$0060
                      (     fps_test.asm):00082                 jsr     Draw_Line_d
                      (     fps_test.asm):00083                 bra     Text
                      (     fps_test.asm):00084          endc
