                      (    glow_test.asm):00001         ; glow_test.asm - Glow Test: one vertical and one horizontal line, full length, moving across the screen and back -
                      (    glow_test.asm):00002         ; still, slow, medium, fast (256 frames each, then again). Buttons 1-4 hold one speed (still / slow / medium / fast).
                      (    glow_test.asm):00003         ; For the overlay's plastic glow: does it stay on the line as it moves, does it flicker.
                      (    glow_test.asm):00004         ; Build: lwasm --format=raw -o glow_test_raw.bin glow_test.asm, then pad to 32768 bytes with $FF (64 KB: twice).
                      (    glow_test.asm):00005         
