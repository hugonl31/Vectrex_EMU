                      ( openbus_test.asm):00001         ; openbus_test.asm - Vectrex test cartridge: what the CPU reads where nothing answers (open bus).
                      ( openbus_test.asm):00002         ; One static page: each line is a read of an address no chip drives ($8000-$BFFF, $C000-$C7FF), done
                      ( openbus_test.asm):00003         ; with a different instruction, and the byte read in hex. On a real Vectrex the floating data bus
                      ( openbus_test.asm):00004         ; decides it (the last byte on the bus? the BIOS $FFFF byte of an idle cycle? all ones?). Mine Storm's
                      ( openbus_test.asm):00005         ; split-mine bug draws such bytes as a vector list (2026-10-14): the emulator needs the real rule.
                      ( openbus_test.asm):00006         ; The last line reads $3408 inside this cartridge (the image is padded with $FF): it shows how the
                      ( openbus_test.asm):00007         ; cartridge maps its image there.
                      ( openbus_test.asm):00008         ; Build: lwasm --format=raw -o openbus_test_raw.bin openbus_test.asm, then pad to 32768 bytes with $FF.
                      ( openbus_test.asm):00009         
     F192             ( openbus_test.asm):00010         Wait_Recal      equ $F192
     F2AB             ( openbus_test.asm):00011         Intensity_a     equ $F2AB
     F354             ( openbus_test.asm):00012         Reset0Ref       equ $F354
     F37A             ( openbus_test.asm):00013         Print_Str_d     equ $F37A
     C82A             ( openbus_test.asm):00014         Vec_Text_HW     equ $C82A
     D004             ( openbus_test.asm):00015         VIA_t1_cnt_lo   equ $D004
                      ( openbus_test.asm):00016         
     C880             ( openbus_test.asm):00017         Vals            equ $C880           ; the bytes read (NVAL)
     C8A0             ( openbus_test.asm):00018         HexBuf          equ $C8A0           ; their hex strings, 3 bytes each (2 digits, $80)
     C8E0             ( openbus_test.asm):00019         Idx             equ $C8E0
     C8E1             ( openbus_test.asm):00020         PosY            equ $C8E1
     000B             ( openbus_test.asm):00021         NVAL            equ 11
                      ( openbus_test.asm):00022         
