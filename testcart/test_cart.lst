     F3DF             (    test_cart.asm):00017         Draw_Line_d     equ $F3DF
     F410             (    test_cart.asm):00018         Draw_VLp        equ $F410
     C811             (    test_cart.asm):00019         Vec_Buttons     equ $C811
     C828             (    test_cart.asm):00020         Vec_Dot_Dwell   equ $C828
     C82A             (    test_cart.asm):00021         Vec_Text_HW     equ $C82A
     C880             (    test_cart.asm):00022         Page            equ $C880
