                      (    test_cart.asm):00001         ; test_cart.asm - Test Cart: four pages to compare the picture between platforms (PC, iPhone / iPad, Android, RetroArch).
                      (    test_cart.asm):00002         ; Buttons 1-4 choose the page; a snapshot at any moment will do (every mover has a steady speed, its trail the same always).
                      (    test_cart.asm):00003         ;   1 TRAIL   the afterglow: bars moving right at 1, 2 and 4 units a frame (intensity $7F), one at 2 at $3F, a dot at 2 -
                      (    test_cart.asm):00004         ;             slow and in a small area (96 x 110 units in the middle): capture it close up
                      (    test_cart.asm):00005         ;   2 LEVELS  seven lines at intensity $10 .. $70 and one at $7F; the same line drawn fast and slow (scale $FF / $20)
                      (    test_cart.asm):00006         ;   3 DOTS    rests of 2 8 32 64 128 255 at intensity $7F, the same at $5F
                      (    test_cart.asm):00007         ;   4 CORNERS a square, a triangle, a cross and a zigzag in joined lines (corner dots, joins)
                      (    test_cart.asm):00008         ; Build: lwasm --format=raw -o test_cart_raw.bin test_cart.asm, then pad to 32768 bytes with $FF (64 KB: twice).
                      (    test_cart.asm):00009         
     F192             (    test_cart.asm):00010         Wait_Recal      equ $F192
