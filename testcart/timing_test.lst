                      (  timing_test.asm):00001         ; timing_test.asm - Vectrex test cartridge for the emulator's analog timing (line ends, corners).
                      (  timing_test.asm):00002         ; Static pages to photograph on a real Vectrex and compare with Vectrex_EMU. Button 4: next page.
                      (  timing_test.asm):00003         ;   Page 1  SQUARES : 16 squares drawn with the BIOS line routine (Draw_VLp, as Mine Storm), at
                      (  timing_test.asm):00004         ;                     scales (timer 1 lengths) 8..23, each labelled with its scale (hex).
                      (  timing_test.asm):00005         ;   Page 2  LINES   : 16 horizontal lines at scales 8..23; after each, a dot is placed separately
                      (  timing_test.asm):00006         ;                     (a beam move of the same vector at the same scale) where the line should end:
                      (  timing_test.asm):00007         ;                     the gap between the lit end and the dot is the line's dark end.
                      (  timing_test.asm):00008         ;   Page 3  BOWTIES : a bow-tie outline at scales 8..23 (one closed path).
                      (  timing_test.asm):00009         ;   Page 4  SHIPS   : Mine Storm's ship (its vector list, as Mine Storm draws it) at scales $0A-$0D,
                      (  timing_test.asm):00010         ;                     top row at Mine Storm's intensity $5F, bottom row at $7F.
                      (  timing_test.asm):00011         ;   Page 5  BIG SHIPS: the same, every vector doubled (twice the speed: the same timing, gaps twice as
                      (  timing_test.asm):00012         ;                     wide - easier to photograph).
                      (  timing_test.asm):00013         ; Build: lwasm --format=raw -o timing_test.bin timing_test.asm  (then pad to 32 KB for the cart)
                      (  timing_test.asm):00014         
     F192             (  timing_test.asm):00015         Wait_Recal      equ $F192
     F1BA             (  timing_test.asm):00016         Read_Btns       equ $F1BA
     F2AB             (  timing_test.asm):00017         Intensity_a     equ $F2AB
     F2C5             (  timing_test.asm):00018         Dot_here        equ $F2C5
     F312             (  timing_test.asm):00019         Moveto_d        equ $F312
     F354             (  timing_test.asm):00020         Reset0Ref       equ $F354
     F37A             (  timing_test.asm):00021         Print_Str_d     equ $F37A
     F410             (  timing_test.asm):00022         Draw_VLp        equ $F410
     C811             (  timing_test.asm):00023         Vec_Buttons     equ $C811
     C82A             (  timing_test.asm):00024         Vec_Text_HW     equ $C82A
     D004             (  timing_test.asm):00025         VIA_t1_cnt_lo   equ $D004
                      (  timing_test.asm):00026         
     C880             (  timing_test.asm):00027         Page            equ $C880           ; 0..2
     C881             (  timing_test.asm):00028         Idx             equ $C881           ; shape number 0..15
     C882             (  timing_test.asm):00029         PosY            equ $C882
     C883             (  timing_test.asm):00030         PosX            equ $C883
